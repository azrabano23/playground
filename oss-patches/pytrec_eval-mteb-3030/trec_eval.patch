From 12152cbfd27c2d42579a11408b4958c2e5cbed9c Mon Sep 17 00:00:00 2001
From: Azra Bano <azrabano.work@gmail.com>
Date: Mon, 28 Sep 2026 23:30:13 +0000
Subject: [PATCH 1/2] Fix te_form_res_rels on queries with no non-negative
 judgments

te_form_res_rels initialised max_rel from the first qrel without
checking that one exists, and never went below that value.

- With an empty qrel list (reachable through library users such as
  pytrec_eval), max_rel was read from uninitialised memory.
- With only negative judgments (e.g. every judgment -2), max_rel + 1
  is <= 0 and the memset of rel_levels gets a negative size, which
  segfaults.

Start max_rel at 0 so rel_levels always has room for level 0, and reset
num_rel_levels per query so it cannot carry over from the previous query.

Also make the per-query cache robust to errors. current_query was
updated before the allocations that can fail, so after an UNDEF return
the next call for the same qid returned the previous query's
saved_res_rels, whose rel_levels may just have been freed.
The cache is now only valid once all values have been computed.
te_chk_and_malloc now resets the bound when malloc fails, instead of
keeping a bound for space that no longer exists.

Adds a quicktest case: qrels.test with every judgment for topic 302
set to -2. Before this change trec_eval segfaults on it. After it,
topics 301 and 303 match out.test.aq exactly.
---
 Makefile                 |    1 +
 form_res_rels.c          |   24 +-
 test/out.test.neg_only   |  387 ++++
 test/qrels.neg_only.test | 3681 ++++++++++++++++++++++++++++++++++++++
 utility_pool.c           |    5 +-
 5 files changed, 4093 insertions(+), 5 deletions(-)
 create mode 100644 test/out.test.neg_only
 create mode 100644 test/qrels.neg_only.test

diff --git a/Makefile b/Makefile
index 535e8d4..6b739e4 100644
--- a/Makefile
+++ b/Makefile
@@ -72,6 +72,7 @@ quicktest: trec_eval
 	./trec_eval -m qrels_jg -q -R qrels_jg  test/qrels.comments.123 test/results.test | diff - test/out.test.qrels_jg
 	./trec_eval -q -miprec_at_recall..10,.20,.25,.75,.50 -m P.5,7,3 -m recall.20,2000 -m Rprec_mult.5.0,0.2,0.35 -mutility.2,-1,0,0 -m 11pt_avg..25,.5,.75 -mndcg.1=3,2=9,4=4.5 -mndcg_cut.10,20,23.4 -msuccess.2,5,20 test/qrels.test test/results.test | diff - test/out.test.meas_params
 	./trec_eval -q -m all_trec -Z test/zscores_file test/qrels.test test/results.test | diff - test/out.test.aqZ
+	./trec_eval -m all_trec -q test/qrels.neg_only.test test/results.test | diff - test/out.test.neg_only
 	/bin/echo "Test succeeeded"
 
 # Don't use this test please
diff --git a/form_res_rels.c b/form_res_rels.c
index 57fe2b4..dff0748 100644
--- a/form_res_rels.c
+++ b/form_res_rels.c
@@ -37,9 +37,11 @@ typedef struct {
     long rel;
 } DOCNO_INFO;
 
-/* Current cached query */
+/* Current cached query.  current_query_valid is only set once all the
+   cached values below have been successfully computed for current_query */
 static char *current_query = "no query";
 static long max_current_query = 0;
+static int current_query_valid = 0;
 
 /* Space reserved for cached returned values */
 static long *rel_levels;
@@ -66,7 +68,7 @@ te_form_res_rels(const EPI * epi, const REL_INFO * rel_info,
 
     TEXT_QRELS *qrels_ptr, *end_qrels;
 
-    if (0 == strcmp(current_query, results->qid)) {
+    if (current_query_valid && 0 == strcmp(current_query, results->qid)) {
         /* Have done this query already. Return cached values */
         *res_rels = saved_res_rels;
         return (0);
@@ -80,6 +82,10 @@ te_form_res_rels(const EPI * epi, const REL_INFO * rel_info,
         return (UNDEF);
     }
 
+    /* Invalidate the cache until the new values are complete, so that an
+       error below cannot leave stale values cached under this qid */
+    current_query_valid = 0;
+
     /* Make sure enough space for query and save copy */
     i = strlen(results->qid) + 1;
     if (NULL == (current_query =
@@ -136,10 +142,17 @@ te_form_res_rels(const EPI * epi, const REL_INFO * rel_info,
 
     /* Find max_rel among qid, reserve and zero space for rel_levels */
     /* Check for duplicate docnos. */
+    /* max_rel starts at 0: the qrels for a query may be empty (possible
+       through the library interface) or hold only negative (unjudged)
+       values, and rel_levels must always have room for level 0 */
     qrels_ptr = trec_qrels->text_qrels;
     end_qrels = &trec_qrels->text_qrels[trec_qrels->num_text_qrels];
-    max_rel = qrels_ptr->rel;
-    qrels_ptr++;
+    max_rel = 0;
+    if (qrels_ptr < end_qrels) {
+        if (max_rel < qrels_ptr->rel)
+            max_rel = qrels_ptr->rel;
+        qrels_ptr++;
+    }
     while (qrels_ptr < end_qrels) {
         if (max_rel < qrels_ptr->rel)
             max_rel = qrels_ptr->rel;
@@ -232,6 +245,7 @@ te_form_res_rels(const EPI * epi, const REL_INFO * rel_info,
         saved_res_rels.num_ret = num_results;
     }
     saved_res_rels.num_rel = 0;
+    saved_res_rels.num_rel_levels = 0;
     for (i = 0; i <= max_rel; i++) {
         if (saved_res_rels.rel_levels[i]) {
             saved_res_rels.num_rel_levels = i + 1;
@@ -241,6 +255,7 @@ te_form_res_rels(const EPI * epi, const REL_INFO * rel_info,
     }
 
     *res_rels = saved_res_rels;
+    current_query_valid = 1;
 
     return (1);
 }
@@ -287,6 +302,7 @@ int te_form_res_rels_cleanup()
         max_current_query = 0;
         current_query = "no_query";
     }
+    current_query_valid = 0;
     if (max_rel_levels > 0) {
         Free(rel_levels);
         max_rel_levels = 0;
