+        np.testing.assert_allclose(
+            returns_dispatch.cond_value_at_risk(nan_returns, engine="rust"),
+            returns_nb.cond_value_at_risk_nb(nan_returns),
+        )
 
     def test_accessor_methods_match_numba(self):
         price = pd.DataFrame(
diff --git a/tests/test_returns.py b/tests/test_returns.py
index 41e4b82..df9b7b9 100644
--- a/tests/test_returns.py
+++ b/tests/test_returns.py
@@ -517,6 +517,18 @@ class TestAccessors:
             ),
         )
 
+    def test_cond_value_at_risk_ignores_nan(self):
+        # NaNs must not count towards the tail size, same as in value_at_risk
+        sr = pd.Series(np.linspace(-0.1, 0.09, 20))
+        sr_nan = pd.concat((pd.Series([np.nan]), sr), ignore_index=True)
+        np.testing.assert_allclose(sr_nan.vbt.returns(freq="d").cond_value_at_risk(cutoff=0.05), -0.1)
+        np.testing.assert_allclose(
+            sr_nan.vbt.returns(freq="d").cond_value_at_risk(cutoff=0.05),
+            sr.vbt.returns(freq="d").cond_value_at_risk(cutoff=0.05),
+        )
+        sr_mostly_nan = pd.Series([np.nan] * 30 + [-0.1])
+        np.testing.assert_allclose(sr_mostly_nan.vbt.returns(freq="d").cond_value_at_risk(cutoff=0.05), -0.1)
+
     def test_capture(self):
         assert isclose(rets["a"].vbt.returns.capture(benchmark_rets["a"]), 0.0007435597416888084)
         pd.testing.assert_series_equal(
diff --git a/vectorbt/returns/nb.py b/vectorbt/returns/nb.py
index 3a420a7..67895bb 100644
--- a/vectorbt/returns/nb.py
+++ b/vectorbt/returns/nb.py
@@ -633,6 +633,7 @@ def rolling_value_at_risk_nb(
 @njit(cache=True)
 def cond_value_at_risk_1d_nb(returns: tp.Array1d, cutoff: float = 0.05) -> float:
     """Conditional value at risk (CVaR) of a returns stream."""
+    returns = returns[~np.isnan(returns)]
     if len(returns) == 0:
         return np.nan
     cutoff_index = int((len(returns) - 1) * cutoff)
