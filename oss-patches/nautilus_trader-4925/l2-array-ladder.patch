+//! Price level storage for one side of an order book.
+//!
+//! [`LadderLevels`] keeps the price levels of a [`BookLadder`](super::ladder::BookLadder) in
+//! best-first order behind a small ordered-map interface, with two backends:
+//!
+//! - `Tree`: a `BTreeMap<BookPrice, BookLevel>`, used for `L1_MBP` and `L3_MBO` books.
+//! - `Sorted`: a contiguous array of levels sorted worst-to-best, used for `L2_MBP` books.
+//!
+//! The sorted backend keeps the best price at the end of the array, so the common updates near
+//! the top of the book find their level in a short binary search over contiguous memory and move
+//! few elements on insert or removal. Emptied levels go to a spare pool and are reused for new
+//! price levels, so after the ladder reaches its high-water depth, adding and removing levels
+//! does not touch the heap.
+//!
+//! Capacity grows on demand (amortized doubling) and is retained until the book is dropped.
+//! Depth beyond the previous high-water mark allocates once; there is no fixed depth limit and
+//! no fallback path.
+
+use std::{
+    collections::{BTreeMap, btree_map},
+    fmt::Debug,
+    iter::{FusedIterator, Rev},
+    ops::{Bound, RangeBounds},
+    slice,
+};
+
+use crate::{
+    data::order::BookOrder,
+    enums::{BookType, OrderSide},
+    orderbook::{BookLevel, BookPrice},
+};
+
+/// Price level storage for one side of an order book, iterated best price first.
+#[derive(Clone)]
+pub(crate) enum LadderLevels {
+    /// Ordered map storage, used for `L1_MBP` and `L3_MBO` books.
+    Tree(BTreeMap<BookPrice, BookLevel>),
+    /// Sorted array storage, used for `L2_MBP` books.
+    Sorted(SortedLevels),
+}
+
+impl LadderLevels {
+    /// Creates empty level storage suited to the given side and book type.
+    #[must_use]
+    pub(crate) fn new(side: OrderSide, book_type: BookType) -> Self {
+        match book_type {
+            BookType::L2_MBP => Self::Sorted(SortedLevels::new(side)),
+            BookType::L1_MBP | BookType::L3_MBO => Self::Tree(BTreeMap::new()),
+        }
+    }
+
+    /// Returns the number of price levels.
+    #[must_use]
+    pub(crate) fn len(&self) -> usize {
+        match self {
+            Self::Tree(map) => map.len(),
+            Self::Sorted(sorted) => sorted.levels.len(),
+        }
+    }
+
+    /// Returns true if there are no price levels.
+    #[must_use]
+    pub(crate) fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    /// Removes all price levels.
+    pub(crate) fn clear(&mut self) {
+        match self {
+            Self::Tree(map) => map.clear(),
+            Self::Sorted(sorted) => sorted.clear(),
+        }
+    }
+
+    /// Returns the level at `price`, if any.
+    #[must_use]
+    pub(crate) fn get(&self, price: &BookPrice) -> Option<&BookLevel> {
+        match self {
+            Self::Tree(map) => map.get(price),
+            Self::Sorted(sorted) => sorted.find(price).ok().map(|idx| &sorted.levels[idx]),
+        }
+    }
+
+    /// Returns a mutable reference to the level at `price`, if any.
+    ///
+    /// Callers must not change the level's price through the returned reference.
+    #[must_use]
+    pub(crate) fn get_mut(&mut self, price: &BookPrice) -> Option<&mut BookLevel> {
+        match self {
+            Self::Tree(map) => map.get_mut(price),
+            Self::Sorted(sorted) => match sorted.find(price) {
+                Ok(idx) => Some(&mut sorted.levels[idx]),
+                Err(_) => None,
+            },
+        }
+    }
+
+    /// Inserts `level` at `price`, returning the level it replaced, if any.
+    ///
+    /// `price` must equal `level.price`.
+    pub(crate) fn insert(&mut self, price: BookPrice, level: BookLevel) -> Option<BookLevel> {
+        debug_assert_eq!(price, level.price);
+
+        match self {
+            Self::Tree(map) => map.insert(price, level),
+            Self::Sorted(sorted) => sorted.insert(level),
+        }
+    }
+
+    /// Creates a new price level holding `order`, where no level exists at `price` yet.
+    ///
+    /// The sorted backend reuses a spare level, so this does not allocate once the ladder has
+    /// reached its high-water depth.
+    pub(crate) fn insert_new_level(&mut self, price: BookPrice, order: BookOrder) {
+        match self {
+            Self::Tree(map) => {
+                let replaced = map.insert(price, BookLevel::from_order(order));
+                debug_assert!(replaced.is_none(), "Level already existed at {price:?}");
+            }
+            Self::Sorted(sorted) => sorted.insert_new_level(price, order),
+        }
+    }
+
+    /// Removes and returns the level at `price`, if any.
+    pub(crate) fn remove(&mut self, price: &BookPrice) -> Option<BookLevel> {
+        match self {
+            Self::Tree(map) => map.remove(price),
+            Self::Sorted(sorted) => match sorted.find(price) {
+                Ok(idx) => Some(sorted.levels.remove(idx)),
+                Err(_) => None,
+            },
+        }
+    }
+
+    /// Removes the level at `price`, if any, without returning it.
+    ///
+    /// The sorted backend keeps the removed level's storage for reuse.
+    pub(crate) fn discard(&mut self, price: &BookPrice) {
+        match self {
+            Self::Tree(map) => {
+                map.remove(price);
+            }
+            Self::Sorted(sorted) => sorted.discard(price),
+        }
+    }
+
+    /// Removes and returns the best level, if any.
+    pub(crate) fn pop_first(&mut self) -> Option<(BookPrice, BookLevel)> {
+        match self {
+            Self::Tree(map) => map.pop_first(),
+            Self::Sorted(sorted) => sorted.levels.pop().map(|level| (level.price, level)),
+        }
+    }
+
+    /// Retains only the levels for which `keep` returns true.
+    pub(crate) fn retain<F>(&mut self, mut keep: F)
+    where
+        F: FnMut(&BookPrice, &mut BookLevel) -> bool,
+    {
+        match self {
+            Self::Tree(map) => map.retain(keep),
+            Self::Sorted(sorted) => {
+                let mut idx = 0;
+                while idx < sorted.levels.len() {
+                    let level = &mut sorted.levels[idx];
+                    let price = level.price;
+                    if keep(&price, level) {
+                        idx += 1;
+                    } else {
+                        let level = sorted.levels.remove(idx);
+                        sorted.spare.push(level);
+                    }
+                }
+            }
+        }
+    }
+
+    /// Returns an iterator over price and level pairs, best price first.
+    #[must_use]
+    pub(crate) fn iter(&self) -> LevelsIter<'_> {
+        match self {
+            Self::Tree(map) => LevelsIter::Tree(map.iter()),
+            Self::Sorted(sorted) => LevelsIter::Sorted(sorted.levels.iter().rev()),
+        }
+    }
+
+    /// Returns an iterator over price and level pairs within `range`, best price first.
+    ///
+    /// Bounds follow [`BookPrice`] ordering, so `..=bound` yields every level at or better than
+    /// `bound`.
+    #[cfg_attr(not(feature = "ffi"), allow(dead_code))]
+    #[must_use]
+    pub(crate) fn range<R>(&self, range: R) -> LevelsRange<'_>
+    where
+        R: RangeBounds<BookPrice>,
+    {
+        match self {
+            Self::Tree(map) => LevelsRange::Tree(map.range(range)),
+            Self::Sorted(sorted) => LevelsRange::Sorted(sorted.range(&range).iter().rev()),
+        }
+    }
+
+    /// Returns an iterator over prices, best price first.
+    pub(crate) fn keys(
+        &self,
+    ) -> impl DoubleEndedIterator<Item = &BookPrice> + ExactSizeIterator + FusedIterator {
+        self.iter().map(|(price, _)| price)
+    }
+
+    /// Returns an iterator over levels, best price first.
+    pub(crate) fn values(
+        &self,
+    ) -> impl DoubleEndedIterator<Item = &BookLevel> + ExactSizeIterator + FusedIterator {
+        self.iter().map(|(_, level)| level)
+    }
+}
+
+impl Debug for LadderLevels {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_map().entries(self.iter()).finish()
+    }
+}
+
+impl<'a> IntoIterator for &'a LadderLevels {
+    type Item = (&'a BookPrice, &'a BookLevel);
+    type IntoIter = LevelsIter<'a>;
+
+    fn into_iter(self) -> Self::IntoIter {
+        self.iter()
+    }
+}
+
+/// Iterator over the price levels of a [`LadderLevels`], best price first.
+pub(crate) enum LevelsIter<'a> {
+    Tree(btree_map::Iter<'a, BookPrice, BookLevel>),
+    Sorted(Rev<slice::Iter<'a, BookLevel>>),
+}
+
+impl<'a> Iterator for LevelsIter<'a> {
+    type Item = (&'a BookPrice, &'a BookLevel);
+
+    #[inline]
+    fn next(&mut self) -> Option<Self::Item> {
+        match self {
+            Self::Tree(iter) => iter.next(),
+            Self::Sorted(iter) => iter.next().map(|level| (&level.price, level)),
+        }
+    }
+
+    #[inline]
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        match self {
+            Self::Tree(iter) => iter.size_hint(),
+            Self::Sorted(iter) => iter.size_hint(),
+        }
+    }
+}
+
+impl DoubleEndedIterator for LevelsIter<'_> {
+    #[inline]
+    fn next_back(&mut self) -> Option<Self::Item> {
+        match self {
+            Self::Tree(iter) => iter.next_back(),
+            Self::Sorted(iter) => iter.next_back().map(|level| (&level.price, level)),
+        }
+    }
+}
+
+impl ExactSizeIterator for LevelsIter<'_> {}
+
+impl FusedIterator for LevelsIter<'_> {}
+
+/// Iterator over the price levels of a [`LadderLevels`] within a price range, best price first.
+#[cfg_attr(not(feature = "ffi"), allow(dead_code))]
+pub(crate) enum LevelsRange<'a> {
+    Tree(btree_map::Range<'a, BookPrice, BookLevel>),
+    Sorted(Rev<slice::Iter<'a, BookLevel>>),
+}
+
+impl<'a> Iterator for LevelsRange<'a> {
+    type Item = (&'a BookPrice, &'a BookLevel);
+
+    #[inline]
+    fn next(&mut self) -> Option<Self::Item> {
+        match self {
+            Self::Tree(iter) => iter.next(),
+            Self::Sorted(iter) => iter.next().map(|level| (&level.price, level)),
+        }
+    }
+
+    #[inline]
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        match self {
+            Self::Tree(iter) => iter.size_hint(),
+            Self::Sorted(iter) => iter.size_hint(),
+        }
+    }
+}
+
+impl DoubleEndedIterator for LevelsRange<'_> {
+    #[inline]
+    fn next_back(&mut self) -> Option<Self::Item> {
+        match self {
+            Self::Tree(iter) => iter.next_back(),
+            Self::Sorted(iter) => iter.next_back().map(|level| (&level.price, level)),
+        }
+    }
+}
+
+impl FusedIterator for LevelsRange<'_> {}
+
+/// Contiguous price levels sorted worst-to-best, with a pool of spare levels for reuse.
+pub(crate) struct SortedLevels {
+    side: OrderSide,
+    /// Active levels, worst price at index 0 and best price at the end.
+    levels: Vec<BookLevel>,
+    /// Emptied levels kept for reuse, so their order storage is not reallocated.
+    spare: Vec<BookLevel>,
+}
+
+impl SortedLevels {
+    fn new(side: OrderSide) -> Self {
+        Self {
+            side,
+            levels: Vec::new(),
+            spare: Vec::new(),
+        }
+    }
+
+    /// Finds `price`, returning its index or the index where it would be inserted.
+    #[inline]
+    fn find(&self, price: &BookPrice) -> Result<usize, usize> {
+        debug_assert_eq!(price.side, self.side);
+        let target = &price.value;
+
+        // Bids are stored ascending and asks descending, so the best price is always last
+        match self.side {
+            OrderSide::Buy => self
+                .levels
+                .binary_search_by(|level| level.price.value.cmp(target)),
+            OrderSide::Sell => self
+                .levels
+                .binary_search_by(|level| target.cmp(&level.price.value)),
+        }
+    }
+
+    fn clear(&mut self) {
+        self.spare.append(&mut self.levels);
+    }
+
+    fn insert(&mut self, level: BookLevel) -> Option<BookLevel> {
+        match self.find(&level.price) {
+            Ok(idx) => Some(std::mem::replace(&mut self.levels[idx], level)),
+            Err(idx) => {
+                self.levels.insert(idx, level);
+                None
+            }
+        }
+    }
+
+    fn insert_new_level(&mut self, price: BookPrice, order: BookOrder) {
+        let found = self.find(&price);
+        debug_assert!(found.is_err(), "Level already existed at {price:?}");
+        let Err(idx) = found else {
+            return;
+        };
+
+        let level = if let Some(mut level) = self.spare.pop() {
+            level.price = price;
+            level.orders.clear();
+            level.add(order);
+            level
+        } else {
+            // Size the pool for every level in existence, so returning levels to it later
+            // never reallocates
+            self.spare.reserve(self.levels.len() + 1);
+            BookLevel::from_order(order)
+        };
+        self.levels.insert(idx, level);
+    }
+
+    fn discard(&mut self, price: &BookPrice) {
+        if let Ok(idx) = self.find(price) {
+            let level = self.levels.remove(idx);
+            self.spare.push(level);
+        }
+    }
+
+    /// Returns the stored (worst-to-best) slice of levels within `range`.
+    #[cfg_attr(not(feature = "ffi"), allow(dead_code))]
+    fn range<R>(&self, range: &R) -> &[BookLevel]
+    where
+        R: RangeBounds<BookPrice>,
+    {
+        // Count levels ordered before `bound` (best-first), optionally including equal ones
+        let count_before = |bound: &BookPrice, inclusive: bool| {
+            let not_before = self.levels.partition_point(|level| {
+                if inclusive {
+                    level.price > *bound
+                } else {
+                    level.price >= *bound
+                }
+            });
+            self.levels.len() - not_before
+        };
+
+        let len = self.levels.len();
+        let start = match range.start_bound() {
+            Bound::Included(bound) => count_before(bound, false),
+            Bound::Excluded(bound) => count_before(bound, true),
+            Bound::Unbounded => 0,
+        };
+        let end = match range.end_bound() {
+            Bound::Included(bound) => count_before(bound, true),
+            Bound::Excluded(bound) => count_before(bound, false),
+            Bound::Unbounded => len,
+        };
+        let end = end.max(start);
+
+        &self.levels[len - end..len - start]
+    }
+}
+
+impl Clone for SortedLevels {
+    // Spare levels are only a cache of storage, so a clone starts without them
+    fn clone(&self) -> Self {
+        Self {
+            side: self.side,
+            levels: self.levels.clone(),
+            spare: Vec::new(),
+        }
+    }
+}
