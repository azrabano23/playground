+
+//! Checks that steady-state `L2_MBP` delta processing does not touch the heap.
+
+use std::{
+    alloc::{GlobalAlloc, Layout, System},
+    cell::Cell,
+};
+
+use nautilus_model::{
+    data::{BookOrder, OrderBookDelta},
+    enums::{BookAction, BookType, OrderSide, RecordFlag},
+    identifiers::InstrumentId,
+    orderbook::OrderBook,
+    types::{Price, Quantity},
+};
+use rstest::rstest;
+
+// Counts heap calls made by the current thread while counting is enabled, so allocations from
+// other test harness threads are not attributed to the code under test
+struct ThreadCountingAlloc;
+
+thread_local! {
+    static COUNTING: Cell<bool> = const { Cell::new(false) };
+    static HEAP_CALLS: Cell<u64> = const { Cell::new(0) };
+}
+
+fn record_heap_call() {
+    let _ = COUNTING.try_with(|counting| {
+        if counting.get() {
+            let _ = HEAP_CALLS.try_with(|calls| calls.set(calls.get() + 1));
+        }
+    });
+}
+
+// SAFETY: Delegates every call to the system allocator unchanged
+unsafe impl GlobalAlloc for ThreadCountingAlloc {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        record_heap_call();
+        unsafe { System.alloc(layout) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        record_heap_call();
+        unsafe { System.dealloc(ptr, layout) }
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        record_heap_call();
+        unsafe { System.alloc_zeroed(layout) }
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        record_heap_call();
+        unsafe { System.realloc(ptr, layout, new_size) }
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: ThreadCountingAlloc = ThreadCountingAlloc;
+
+fn count_heap_calls(f: impl FnOnce()) -> u64 {
+    HEAP_CALLS.with(|calls| calls.set(0));
+    COUNTING.with(|counting| counting.set(true));
+    f();
+    COUNTING.with(|counting| counting.set(false));
+    HEAP_CALLS.with(Cell::get)
+}
+
+fn delta(action: BookAction, side: OrderSide, tick: i64, size: u64, flags: u8) -> OrderBookDelta {
+    let order = BookOrder::new(
+        side,
+        Price::from_mantissa_exponent(tick, -2, 2),
+        Quantity::from(size),
+        0,
+    );
+    OrderBookDelta::new(
+        InstrumentId::from("AAPL.XNAS"),
+        action,
+        order,
+        flags,
+        0,
+        0.into(),
+        0.into(),
+    )
+}
+
+/// A snapshot of `depth` levels per side, then a drifting market that adds, updates, and
+/// deletes levels at the top and at the depth boundary.
+fn delta_stream(depth: i64, steps: i64) -> Vec<OrderBookDelta> {
+    let mut deltas = vec![OrderBookDelta::clear(
+        InstrumentId::from("AAPL.XNAS"),
+        0,
+        0.into(),
+        0.into(),
+    )];
+
+    for k in 0..depth {
+        let flags = RecordFlag::F_SNAPSHOT as u8;
+        deltas.push(delta(BookAction::Add, OrderSide::Buy, 9_999 - k, 10, flags));
+        deltas.push(delta(
+            BookAction::Add,
+            OrderSide::Sell,
+            10_000 + k,
+            10,
+            flags,
+        ));
+    }
+    deltas.last_mut().unwrap().flags |= RecordFlag::F_LAST as u8;
+
+    let (mut best_bid, mut best_ask) = (9_999, 10_000);
+
+    for step in 0..steps {
+        let size = 1 + (step as u64 % 7);
+        deltas.push(delta(BookAction::Update, OrderSide::Buy, best_bid, size, 0));
+        deltas.push(delta(
+            BookAction::Update,
+            OrderSide::Sell,
+            best_ask - 1 + depth,
+            size,
+            0,
+        ));
+
+        // Drift up for half the cycle and down for the other half
+        if (step / 16) % 2 == 0 {
+            deltas.push(delta(BookAction::Delete, OrderSide::Sell, best_ask, 0, 0));
+            deltas.push(delta(
+                BookAction::Add,
+                OrderSide::Sell,
+                best_ask + depth,
+                10,
+                0,
+            ));
+            best_ask += 1;
+            deltas.push(delta(
+                BookAction::Delete,
+                OrderSide::Buy,
+                best_bid - depth + 1,
+                0,
+                0,
+            ));
+            best_bid += 1;
+            deltas.push(delta(BookAction::Add, OrderSide::Buy, best_bid, 10, 0));
+        } else {
+            deltas.push(delta(BookAction::Delete, OrderSide::Buy, best_bid, 0, 0));
+            deltas.push(delta(
+                BookAction::Add,
+                OrderSide::Buy,
+                best_bid - depth,
+                10,
+                0,
+            ));
+            best_bid -= 1;
+            deltas.push(delta(
+                BookAction::Delete,
+                OrderSide::Sell,
+                best_ask + depth - 1,
+                0,
+                0,
+            ));
+            best_ask -= 1;
+            deltas.push(delta(BookAction::Add, OrderSide::Sell, best_ask, 10, 0));
+        }
+    }
+
+    deltas
+}
+
+#[rstest]
+#[case::depth_10(10)]
+#[case::depth_100(100)]
+fn test_l2_steady_state_deltas_do_not_allocate(#[case] depth: i64) {
+    let deltas = delta_stream(depth, 256);
+    let mut book = OrderBook::new(InstrumentId::from("AAPL.XNAS"), BookType::L2_MBP);
+
+    // The first pass sizes level storage to the stream's high-water depth
+    for delta in &deltas {
+        book.apply_delta(delta).unwrap();
+    }
+
+    // The second pass starts with a clear and snapshot, so it also covers rebuilding the book
+    let heap_calls = count_heap_calls(|| {
+        for delta in &deltas {
+            book.apply_delta(delta).unwrap();
+        }
+    });
+
+    assert_eq!(heap_calls, 0);
+    assert_eq!(book.bids(None).count(), depth as usize);
+    assert_eq!(book.asks(None).count(), depth as usize);
+}
