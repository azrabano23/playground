+
+    // Differential testing: every L2 delta stream must leave the sorted-array book and a book
+    // forced onto the previous `BTreeMap` storage in the same observable state.
+
+    #[derive(Clone, Debug)]
+    enum L2Operation {
+        Delta {
+            action: BookAction,
+            side: Option<OrderSide>,
+            tick: u8,
+            size: u8,
+            id_from_price: bool,
+            flags: u8,
+        },
+        ClearStaleLevels(Option<OrderSide>),
+        ClearBids,
+        ClearAsks,
+        Reset,
+    }
+
+    fn l2_operation_strategy() -> impl Strategy<Value = L2Operation> {
+        let action = prop_oneof![
+            3 => Just(BookAction::Add),
+            6 => Just(BookAction::Update),
+            3 => Just(BookAction::Delete),
+            1 => Just(BookAction::Clear),
+        ];
+        let side = prop_oneof![
+            8 => Just(Some(OrderSide::Buy)),
+            8 => Just(Some(OrderSide::Sell)),
+            1 => Just(None),
+        ];
+        let flags = prop_oneof![
+            Just(0u8),
+            Just(RecordFlag::F_LAST as u8),
+            Just(RecordFlag::F_SNAPSHOT as u8),
+            Just(RecordFlag::F_SNAPSHOT as u8 | RecordFlag::F_LAST as u8),
+            Just(RecordFlag::F_MBP as u8),
+            Just(RecordFlag::F_MBP as u8 | RecordFlag::F_LAST as u8),
+        ];
+        let delta = (action, side, 0u8..48, 0u8..6, any::<bool>(), flags).prop_map(
+            |(action, side, tick, size, id_from_price, flags)| L2Operation::Delta {
+                action,
+                side,
+                tick,
+                size,
+                id_from_price,
+                flags,
+            },
+        );
+
+        prop_oneof![
+            60 => delta,
+            1 => prop_oneof![
+                Just(None),
+                Just(Some(OrderSide::Buy)),
+                Just(Some(OrderSide::Sell)),
+            ]
+            .prop_map(L2Operation::ClearStaleLevels),
+            1 => Just(L2Operation::ClearBids),
+            1 => Just(L2Operation::ClearAsks),
+            1 => Just(L2Operation::Reset),
+        ]
+    }
+
+    fn tick_price(tick: u8) -> Price {
+        let tick_raw = Price::from("0.01").raw * PriceRaw::from(tick);
+        Price::from_raw(Price::from("100.00").raw + tick_raw, 2)
+    }
+
+    fn tree_backed_l2_book(instrument_id: InstrumentId) -> OrderBook {
+        let mut book = OrderBook::new(instrument_id, BookType::L2_MBP);
+        book.bids.levels = LadderLevels::Tree(BTreeMap::new());
+        book.asks.levels = LadderLevels::Tree(BTreeMap::new());
+        book
+    }
+
+    fn apply_operation(
+        book: &mut OrderBook,
+        operation: &L2Operation,
+        sequence: u64,
+    ) -> Option<String> {
+        match *operation {
+            L2Operation::Delta {
+                action,
+                side,
+                tick,
+                size,
+                id_from_price,
+                flags,
+            } => {
+                let price = tick_price(tick);
+                let mut order = BookOrder {
+                    side,
+                    price,
+                    size: Quantity::from(u64::from(size)),
+                    order_id: u64::from(tick) + 1,
+                };
+
+                // Use the book's own price-based ID so no-side deltas can resolve their side
+                if id_from_price {
+                    order.order_id = pre_process_order(BookType::L2_MBP, order, flags).order_id;
+                }
+
+                if action == BookAction::Clear {
+                    order = BookOrder::default();
+                }
+
+                let delta = OrderBookDelta {
+                    instrument_id: book.instrument_id,
+                    action,
+                    order,
+                    flags,
+                    sequence,
+                    ts_event: sequence.into(),
+                    ts_init: sequence.into(),
+                };
+                Some(format!("{:?}", book.apply_delta(&delta)))
+            }
+            L2Operation::ClearStaleLevels(side) => {
+                Some(format!("{:?}", book.clear_stale_levels(side)))
+            }
+            L2Operation::ClearBids => {
+                book.clear_bids(sequence, sequence.into());
+                None
+            }
+            L2Operation::ClearAsks => {
+                book.clear_asks(sequence, sequence.into());
+                None
+            }
+            L2Operation::Reset => {
+                book.reset();
+                None
+            }
+        }
+    }
+
+    fn assert_books_match(book: &OrderBook, reference: &OrderBook) {
+        let snapshot = |levels: &mut dyn Iterator<Item = &BookLevel>| {
+            levels
+                .map(|level| (level.price, level.get_orders()))
+                .collect::<Vec<_>>()
+        };
+
+        for depth in [None, Some(1), Some(3)] {
+            assert_eq!(
+                snapshot(&mut book.bids(depth)),
+                snapshot(&mut reference.bids(depth))
+            );
+            assert_eq!(
+                snapshot(&mut book.asks(depth)),
+                snapshot(&mut reference.asks(depth))
+            );
+        }
+
+        assert_eq!(book.bids.len(), reference.bids.len());
+        assert_eq!(book.asks.len(), reference.asks.len());
+        assert_eq!(book.bids.cache, reference.bids.cache);
+        assert_eq!(book.asks.cache, reference.asks.cache);
+        assert_eq!(book.sequence, reference.sequence);
+        assert_eq!(book.ts_last, reference.ts_last);
+        assert_eq!(book.update_count, reference.update_count);
+        assert_eq!(book.best_bid_price(), reference.best_bid_price());
+        assert_eq!(book.best_ask_price(), reference.best_ask_price());
+        assert_eq!(book.best_bid_size(), reference.best_bid_size());
+        assert_eq!(book.best_ask_size(), reference.best_ask_size());
+        assert_eq!(book_check_integrity(book), book_check_integrity(reference));
+        assert_eq!(
+            format!("{:?}", book.bids.levels),
+            format!("{:?}", reference.bids.levels)
+        );
+        assert_eq!(
+            format!("{:?}", book.asks.levels),
+            format!("{:?}", reference.asks.levels)
+        );
+        assert_eq!(book.pprint(3, None), reference.pprint(3, None));
+        assert_eq!(
+            book.to_deltas(1.into(), 1.into()),
+            reference.to_deltas(1.into(), 1.into())
+        );
+
+        for tick in [0, 11, 23, 47] {
+            let price = tick_price(tick);
+            for side in [OrderSide::Buy, OrderSide::Sell] {
+                assert_eq!(
+                    book.get_quantity_for_price(price, side),
+                    reference.get_quantity_for_price(price, side)
+                );
+                assert_eq!(
+                    book.get_quantity_at_level(price, side, 0),
+                    reference.get_quantity_at_level(price, side, 0)
+                );
+                assert_eq!(
+                    book.get_all_crossed_levels(side, price, 0),
+                    reference.get_all_crossed_levels(side, price, 0)
+                );
+            }
+
+            let bid_bound = BookPrice::new(price, OrderSide::Buy);
+            let ask_bound = BookPrice::new(price, OrderSide::Sell);
+            assert!(
+                book.bids
+                    .levels
+                    .range(..=bid_bound)
+                    .eq(reference.bids.levels.range(..=bid_bound))
+            );
+            assert!(
+                book.asks
+                    .levels
+                    .range(..=ask_bound)
+                    .eq(reference.asks.levels.range(..=ask_bound))
+            );
+        }
+
+        let qty = Quantity::from(7);
+        for side in [OrderSide::Buy, OrderSide::Sell] {
+            assert_eq!(
+                book.get_avg_px_for_quantity(qty, side).to_bits(),
+                reference.get_avg_px_for_quantity(qty, side).to_bits()
+            );
+            assert_eq!(
+                book.get_worst_px_for_quantity(qty, side),
+                reference.get_worst_px_for_quantity(qty, side)
+            );
+            let (avg, size, last) = book.get_avg_px_qty_for_exposure(qty, side);
+            let (ref_avg, ref_size, ref_last) = reference.get_avg_px_qty_for_exposure(qty, side);
+            assert_eq!(
+                (avg.to_bits(), size.to_bits(), last.to_bits()),
+                (ref_avg.to_bits(), ref_size.to_bits(), ref_last.to_bits())
+            );
+        }
+    }
+
+    fn check_l2_equivalence(operations: &[L2Operation]) {
+        let instrument_id = InstrumentId::from("AAPL.XNAS");
+        let mut book = OrderBook::new(instrument_id, BookType::L2_MBP);
+        let mut reference = tree_backed_l2_book(instrument_id);
+        assert!(matches!(book.bids.levels, LadderLevels::Sorted(_)));
+        assert!(matches!(reference.bids.levels, LadderLevels::Tree(_)));
+
+        for (idx, operation) in operations.iter().enumerate() {
+            let sequence = idx as u64 + 1;
+            let result = apply_operation(&mut book, operation, sequence);
+            let reference_result = apply_operation(&mut reference, operation, sequence);
+
+            assert_eq!(result, reference_result, "operation {idx}: {operation:?}");
+            assert_books_match(&book, &reference);
+        }
+    }
+
+    #[rstest]
+    fn prop_test_l2_sorted_levels_match_tree_levels() {
+        proptest!(ProptestConfig::with_cases(512), |(
+            operations in prop::collection::vec(l2_operation_strategy(), 1..=200),
+        )| {
+            check_l2_equivalence(&operations);
+        });
+    }
+}
