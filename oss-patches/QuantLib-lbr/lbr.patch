+    BOOST_CHECK_THROW(blackFormulaImpliedStdDevLetsBeRational(Option::Call, 80.0, forward,
+                                                              discount * forward * 1.01, discount),
+                      Error);
+
+    // invalid inputs
+    BOOST_CHECK_THROW(
+        blackFormulaImpliedStdDevLetsBeRational(Option::Call, 100.0, forward, -1.0, discount),
