+                        << std::setprecision(17) << "\n type:       " << c.type
+                        << "\n strike:     " << c.strike << "\n price:      " << lbr.price
+                        << "\n stdDev:     " << c.stdDev << "\n implied:    " << implied
+                        << "\n rel. error: " << error);
