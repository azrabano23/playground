+    BOOST_CHECK_THROW(
+        blackFormulaImpliedStdDevLetsBeRational(Option::Call, 100.0, forward, 5.0, 0.0), Error);
+    BOOST_CHECK_THROW(
+        blackFormulaImpliedStdDevLetsBeRational(Option::Call, 100.0, forward, 5.0, 1.0, -1.0),
