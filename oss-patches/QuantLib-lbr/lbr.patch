index 0000000..0baa506
--- /dev/null
+++ b/ql/pricingengines/letsberational.cpp
@@ -0,0 +1,711 @@
+/* -*- mode: c++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+
