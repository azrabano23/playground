+    // +max), so a sign change is only accepted if f is actually close to zero at the refined point;
+    // otherwise the search continues with the next interval. Of the final bracket we return the end where
+    // f >= 0: for the functions below this means that the path does not exceed the maximum pitch.
+    template <typename F>
+    std::optional<double> smallestRoot(const F &f, double lo, double hi, unsigned int numSteps, double tolerance)
+    {
+        if (hi <= lo)
+            return {};
+        double a = lo, fa = f(a);
+        if (fa == 0.)
+            return a;
+        for (unsigned int i = 1; i <= numSteps; ++i)
+        {
+            double b = lo + (hi - lo) * i / numSteps, fb = f(b);
+            if ((fa < 0.) != (fb < 0.))
