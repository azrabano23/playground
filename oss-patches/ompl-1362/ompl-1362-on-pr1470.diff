+// Regression test for https://github.com/ompl/ompl/issues/1362: the root finding in OwenStateSpace::getPath
+// used to fail for a large fraction of random state pairs.
+BOOST_AUTO_TEST_CASE(Owen_RandomPairs)
+{
+    const double turnRadius = 1., maxPitch = PI / 6., tanMaxPitch = std::tan(maxPitch);
+    auto space(std::make_shared<base::OwenStateSpace>(turnRadius, maxPitch));
+    base::ScopedState<base::OwenStateSpace> s1(space), s2(space), s(space);
+    RNG rng(1362);
+
+    unsigned int numPaths = 0;
+    for (unsigned int i = 0; i < 2000; ++i)
+    {
+        for (auto *state : {s1.get(), s2.get()})
+        {
+            for (unsigned int j = 0; j < 3; ++j)
+                (*state)[j] = rng.uniformReal(-10., 10.);
+            state->yaw() = rng.uniformReal(-PI, PI);
+        }
+        double dz = s2[2] - s1[2];
+        double dxy = std::hypot(s2[0] - s1[0], s2[1] - s1[1]);
+        auto path = space->getPath(s1.get(), s2.get());
+        if (!path)
+        {
+            // The path types of Owen et al. cannot produce every horizontal length when the start and goal
+            // positions are close together, so a few pairs within 4 turn radii genuinely have no solution.
+            BOOST_CHECK_LT(dxy, 4. * turnRadius);
+            continue;
+        }
+        ++numPaths;
+
+        // The path must end at the goal.
+        space->interpolate(s1.get(), s2.get(), 1. - 1e-12, *path, s.get());
+        BOOST_OMPL_EXPECT_NEAR(s[0], s2[0], 1e-6);
+        BOOST_OMPL_EXPECT_NEAR(s[1], s2[1], 1e-6);
+        BOOST_OMPL_EXPECT_NEAR(s[2], s2[2], 1e-6);
+        BOOST_CHECK_SMALL(std::remainder(s->yaw() - s2->yaw(), 2. * PI), 1e-6);
+
+        // Reference length without any root finding: if the shortest 2D Dubins path is long enough to change
+        // altitude by dz, it is optimal. Otherwise every path has to fly at least |dz| / tan(maxPitch)
+        // horizontally, so |dz| / sin(maxPitch) is a lower bound, and a path at max pitch attains it.
+        double dubinsLength = turnRadius * base::DubinsStateSpace::getPath(s1.get(), s2.get(), turnRadius).length();
+        double reference = std::abs(dz) <= dubinsLength * tanMaxPitch ? std::hypot(dubinsLength, dz) :
+                                                                        std::abs(dz) / std::sin(maxPitch);
+        BOOST_CHECK_CLOSE(path->length(), reference, 1e-4);
+        BOOST_CHECK_CLOSE(space->distance(s1.get(), s2.get()), reference, 1e-4);
+        BOOST_CHECK_GE(path->turnRadius_, turnRadius);
+    }
+    // Before the fix about 1% of these pairs failed; now only a few pairs that are very close together do.
+    BOOST_CHECK_GE(numPaths, 1995u);
+}
