From b42079608ec7e61c57a17f05035077b45357f15a Mon Sep 17 00:00:00 2001
From: Azra Bano <azrabano.work@gmail.com>
Date: Mon, 28 Sep 2026 22:51:48 +0000
Subject: [PATCH] ICE: keep 2025-01-09 as a trading day

ICE Futures U.S. did not close for the National Day of Mourning for
President Carter; per its exchange notice only a few index, SOFR and
mortgage-rate contracts ended early and all other contracts followed
regular trading hours. Since 2025-01-09 was added to the shared
USNationalDaysofMourning list, the ICE calendar has dropped that day.

Exclude it from the ICE ad hoc holidays.
---
 pandas_market_calendars/calendars/ice.py | 4 +++-
 tests/test_ice_calendar.py               | 7 +++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/pandas_market_calendars/calendars/ice.py b/pandas_market_calendars/calendars/ice.py
index 3d64cc5..24392c7 100644
--- a/pandas_market_calendars/calendars/ice.py
+++ b/pandas_market_calendars/calendars/ice.py
@@ -69,7 +69,9 @@ class ICEExchangeCalendar(MarketCalendar):
     def adhoc_holidays(self) -> List[Any]:
         return list(
             chain(
-                USNationalDaysofMourning,
+                # ICE Futures U.S. kept regular hours for nearly all contracts on the 2025-01-09 day of mourning
+                # https://www.ice.com/publicdocs/futures_us/exchange_notices/ICE_Futures_US_ExNot2024MomentOfSilence20241230.pdf
+                [d for d in USNationalDaysofMourning if d != Timestamp("2025-01-09", tz="UTC")],
                 # ICE was only closed on the first day of the Hurricane Sandy
                 # closings (was not closed on 2012-10-30)
                 [Timestamp("2012-10-29", tz="UTC")],
diff --git a/tests/test_ice_calendar.py b/tests/test_ice_calendar.py
index c467b17..94f22aa 100644
--- a/tests/test_ice_calendar.py
+++ b/tests/test_ice_calendar.py
@@ -55,3 +55,10 @@ def test_2016_early_closes():
         market_close = schedule.loc[dt].market_close
         # all ICE early closes are 1 pm local
         assert market_close.tz_convert(ice.tz).hour == 13
+
+
+def test_2025_carter_day_of_mourning_open():
+    # ICE Futures U.S. traded regular hours for all but a handful of contracts on 2025-01-09
+    # https://www.ice.com/publicdocs/futures_us/exchange_notices/ICE_Futures_US_ExNot2024MomentOfSilence20241230.pdf
+    dates_open = ICEExchangeCalendar().valid_days("2025-01-06", "2025-01-10")
+    assert pd.Timestamp("2025-01-09", tz="UTC") in dates_open
-- 
