 doc/source/iv/introduction.rst                |  2 +-
 linearmodels/panel/model.py                   | 11 +++++++-
 linearmodels/panel/results.py                 |  5 +++-
 linearmodels/tests/panel/test_panel_ols.py    | 27 ++++++++++++++++++-
 .../panel/test_simulated_against_stata.py     |  9 ++++++-
 5 files changed, 49 insertions(+), 5 deletions(-)

