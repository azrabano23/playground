+++ b/doc/source/iv/introduction.rst
@@ -129,7 +129,7 @@ GMM and GMM-CUE Estimation
     :class:`~linearmodels.iv.gmm.HeteroskedasticWeightMatrix`.
   * 'kernel' - Allows for both heteroskedasticity and autocorrelation in the
     moment conditions. See :class:`~linearmodels.iv.gmm.KernelWeightMatrix`.
-  * 'cluster' - Allows for a one-way cluster structure where moment
+  * 'clustered' - Allows for a one-way cluster structure where moment
     conditions within a cluster are correlated.
     See :class:`~linearmodels.iv.gmm.OneWayClusteredWeightMatrix`.
 
diff --git a/linearmodels/panel/model.py b/linearmodels/panel/model.py
index 9a997a9..99fa6df 100644
--- a/linearmodels/panel/model.py
+++ b/linearmodels/panel/model.py
@@ -2062,13 +2062,22 @@ class PanelOLS(_PanelModelBase):
 
             denom = resid_ss / df_denom
             stat = num / denom
-            f_pooled = WaldTestStatistic(
+            f_pooled: WaldTestStatistic = WaldTestStatistic(
                 stat,
                 "Effects are zero",
                 df_num,
                 df_denom=df_denom,
                 name="Pooled F-statistic",
             )
+            if type(cov) is not HomoskedasticCovariance:
+                # The poolability test is a classical F built from residual sums
+                # of squares and so is only valid under homoskedasticity.  There
+                # is no simple robust analog, so it is not reported (as in Stata).
+                f_pooled = InvalidTestStatistic(
+                    "The poolability F-test is only valid under homoskedasticity. "
+                    'Refit using cov_type="unadjusted" to compute this test.',
+                    name="Pooled F-statistic",
+                )
             res.update(f_pooled=f_pooled)
             effects = DataFrame(
                 eps_effects - eps,
