diff --git a/test/engine/engine_solver_test.cc b/test/engine/engine_solver_test.cc
index 5792dfd..ede0d32 100644
--- a/test/engine/engine_solver_test.cc
+++ b/test/engine/engine_solver_test.cc
@@ -765,6 +765,68 @@ TEST_F(SolverTest, ConeFoldEquivalent) {
   }
 }
 
+// With elliptic cones and a large impratio, the curvature of the linesearch
+// cost jumps by orders of magnitude where a contact crosses the cone boundary.
+// Newton steps from the bracket ends overshoot across the jump, and this state
+// from GitHub issue #3628 needed 23 evaluations by bisection: with
+// ls_iterations=20 the search returned no improvement and the solver stopped at
+// a non-minimizer, a fixed point of restarting from its own qacc.
+TEST_F(SolverTest, EllipticLineSearchCrossesConeBoundary) {
+  constexpr char xml[] = R"(
+  <mujoco>
+    <option timestep="0.0025" cone="elliptic" impratio="10"
+            integrator="implicitfast" iterations="100" tolerance="1e-8"/>
+    <worldbody>
+      <geom type="plane" size="5 5 .1"/>
+      <body pos="0 0 .3">
+        <freejoint/>
+        <geom type="box" size=".2 .1 .05" mass="5"/>
+      </body>
+    </worldbody>
+  </mujoco>
+  )";
+  const mjtNum qpos[7] = {-0.38228398123211904, -1.5617372196006747,
+                          0.14420735808017446,  -0.3039178177313174,
+                          0.6782960782869877,   -0.6545711847046525,
+                          -0.1381483058176044};
+  const mjtNum qvel[6] = {-2.5320433011146646, 0.4435273997725518,
+                          -3.833483970428372,  20.58784610148961,
+                          -4.891237201965733,  -1.521169201653485};
+  const mjtNum qacc_warmstart[6] = {196.2178511861834,  185.09984762860262,
+                                    456.16231234940415, -2622.9781161564592,
+                                    1990.857671015227,  -729.4643685817738};
+
+  char error[1024];
+  MjModelPtr model = LoadModelFromString(xml, error, sizeof(error));
+  ASSERT_THAT(model.get(), NotNull()) << error;
+  MjDataPtr data = MakeData(model);
+
+  auto solve = [&](int ls_iterations) {
+    model->opt.ls_iterations = ls_iterations;
+    mj_resetData(model.get(), data.get());
+    mju_copy(data->qpos, qpos, 7);
+    mju_copy(data->qvel, qvel, 6);
+    mju_copy(data->qacc_warmstart, qacc_warmstart, 6);
+    mj_forward(model.get(), data.get());
+    return std::vector<mjtNum>(data->qacc, data->qacc + model->nv);
+  };
+
+  std::vector<mjtNum> reference = solve(200);
+  std::vector<mjtNum> qacc = solve(20);
+  ASSERT_EQ(data->ncon, 1);
+
+  // every linesearch converges within its budget
+  int niter = std::min(data->solver_niter[0], mjNSOLVER);
+  for (int i = 0; i < niter; i++) {
+    EXPECT_LT(data->solver[i].neval, 20) << "iteration " << i;
+  }
+
+  // the solution matches the one found with a large linesearch budget
+  for (int i = 0; i < model->nv; i++) {
+    EXPECT_THAT(qacc[i], MjNear(reference[i], 1e-6, 1e-1)) << "dof " << i;
+  }
+}
+
