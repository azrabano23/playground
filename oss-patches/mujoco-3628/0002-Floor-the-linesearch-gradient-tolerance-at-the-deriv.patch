@@ -2014,6 +2024,20 @@ static int PrimalKink(const mjPrimalContext* ctx, mjtNum lo, mjtNum hi, mjtNum t
 }
 
 
+// machine epsilon of mjtNum
+#ifdef mjUSESINGLE
+  #define mjLS_EPS FLT_EPSILON
+#else
+  #define mjLS_EPS DBL_EPSILON
+#endif
+
+// gradient tolerance at alpha, floored at the rounding noise of the derivative: below it the
+// sign of the derivative is not resolved and further bracketing only chases noise
+static mjtNum LStol(const mjPrimalContext* ctx, mjtNum gtol, mjtNum alpha) {
+  return mju_max(gtol, mjLS_EPS*(ctx->LSnoise[0] + mju_abs(alpha)*ctx->LSnoise[1]));
+}
