     // pointers to numeric data
@@ -1633,6 +1640,9 @@ static void PrimalPrepare(mjPrimalContext* ctx) {
     // apply scaling
     quad[0] *= 0.5;
     quad[2] *= 0.5;
+
+    ctx->LSnoise[0] += mju_abs(quad[1]);
+    ctx->LSnoise[1] += 2*quad[2];
