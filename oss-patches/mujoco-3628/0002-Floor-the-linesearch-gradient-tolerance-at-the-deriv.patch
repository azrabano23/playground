+  mjtNum vMa = mju_dot(v, ctx->Ma, nv), vqfrc = mju_dot(ctx->qfrc_smooth, v, nv);
+  ctx->quadGauss[1] = vMa - vqfrc;
   ctx->quadGauss[2] = 0.5*mju_dot(v, ctx->Mv, nv);
 
+  // magnitude of the terms summed into the linesearch derivative, bounds its rounding error
+  ctx->LSnoise[0] = mju_abs(vMa) + mju_abs(vqfrc);
+  ctx->LSnoise[1] = 2*ctx->quadGauss[2];
