@@ -1568,9 +1570,14 @@ static void PrimalPrepare(mjPrimalContext* ctx) {
 
   // Gauss: alpha^2*0.5*v'*M*v + alpha*v'*(Ma-qfrc_smooth) + 0.5*(a-qacc_smooth)'*(Ma-qfrc_smooth)
