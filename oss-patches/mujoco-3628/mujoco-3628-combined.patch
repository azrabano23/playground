+// State from GitHub issue #3628: a free box on a plane with elliptic cones and
+// impratio=10, whose second Newton linesearch crosses the cone boundary.
+constexpr char kIssue3628Xml[] = R"(
+<mujoco>
+  <option timestep="0.0025" cone="elliptic" impratio="10"
+          integrator="implicitfast" iterations="100" tolerance="1e-8"/>
+  <worldbody>
+    <geom type="plane" size="5 5 .1"/>
+    <body pos="0 0 .3">
+      <freejoint/>
+      <geom type="box" size=".2 .1 .05" mass="5"/>
+    </body>
+  </worldbody>
+</mujoco>
+)";
+
+// set the issue's state and solve, return qacc
+std::vector<mjtNum> SolveIssue3628(const mjModel* model, mjData* data) {
+  const mjtNum qpos[7] = {-0.38228398123211904, -1.5617372196006747,
+                          0.14420735808017446,  -0.3039178177313174,
+                          0.6782960782869877,   -0.6545711847046525,
+                          -0.1381483058176044};
+  const mjtNum qvel[6] = {-2.5320433011146646, 0.4435273997725518,
+                          -3.833483970428372,  20.58784610148961,
+                          -4.891237201965733,  -1.521169201653485};
+  const mjtNum qacc_warmstart[6] = {196.2178511861834,  185.09984762860262,
+                                    456.16231234940415, -2622.9781161564592,
+                                    1990.857671015227,  -729.4643685817738};
+  mj_resetData(model, data);
+  mju_copy(data->qpos, qpos, 7);
+  mju_copy(data->qvel, qvel, 6);
+  mju_copy(data->qacc_warmstart, qacc_warmstart, 6);
+  mj_forward(model, data);
+  return std::vector<mjtNum>(data->qacc, data->qacc + model->nv);
+}
+
+// With elliptic cones and a large impratio, the curvature of the linesearch
+// cost jumps by orders of magnitude where a contact crosses the cone boundary.
+// Newton steps from the bracket ends overshoot across the jump, and this state
+// needed 23 evaluations by bisection: with ls_iterations=20 the search returned
+// no improvement and the solver stopped at a non-minimizer, a fixed point of
+// restarting from its own qacc.
+TEST_F(SolverTest, EllipticLineSearchCrossesConeBoundary) {
+  char error[1024];
+  MjModelPtr model = LoadModelFromString(kIssue3628Xml, error, sizeof(error));
+  ASSERT_THAT(model.get(), NotNull()) << error;
+  MjDataPtr data = MakeData(model);
+
+  model->opt.ls_iterations = 200;
+  std::vector<mjtNum> reference = SolveIssue3628(model.get(), data.get());
+  model->opt.ls_iterations = 20;
+  std::vector<mjtNum> qacc = SolveIssue3628(model.get(), data.get());
+  ASSERT_EQ(data->ncon, 1);
+
+  // every linesearch converges within its budget
+  int niter = std::min(data->solver_niter[0], mjNSOLVER);
+  for (int i = 0; i < niter; i++) {
+    EXPECT_LT(data->solver[i].neval, 20) << "iteration " << i;
+  }
+
+  // the solution matches the one found with a large linesearch budget
+  for (int i = 0; i < model->nv; i++) {
+    EXPECT_THAT(qacc[i], MjNear(reference[i], 1e-6, 1e-1)) << "dof " << i;
+  }
+}
+
+// A linesearch that uses all ls_iterations raises mjWARN_LINESEARCH; one that
+// runs out without improvement, ending the solve, is recorded as an iteration.
+TEST_F(SolverTest, LineSearchExhaustedWarning) {
+  mock_warning_handler.ExpectWarnings("Linesearch used all 5 ls_iterations");
+  char error[1024];
+  MjModelPtr model = LoadModelFromString(kIssue3628Xml, error, sizeof(error));
+  ASSERT_THAT(model.get(), NotNull()) << error;
+  MjDataPtr data = MakeData(model);
+
+  // too small a budget for the second linesearch
+  model->opt.ls_iterations = 5;
+  SolveIssue3628(model.get(), data.get());
+  int niter = data->solver_niter[0];
+  ASSERT_GT(niter, 0);
+  ASSERT_LE(niter, mjNSOLVER);
+  EXPECT_GE(data->solver[niter - 1].neval, 5);
+  EXPECT_EQ(data->solver[niter - 1].improvement, 0);
+  EXPECT_EQ(data->warning[mjWARN_LINESEARCH].number, 1);
+  EXPECT_EQ(data->warning[mjWARN_LINESEARCH].lastinfo, 5);
+
+  // default budget: no warning
+  model->opt.ls_iterations = 50;
+  SolveIssue3628(model.get(), data.get());
+  EXPECT_EQ(data->warning[mjWARN_LINESEARCH].number, 0);
+}
+
+// With tolerance=0 (or a tolerance below what the precision resolves) the
+// linesearch cannot meet its gradient tolerance: it used to exhaust
+// ls_iterations at nearly every iteration, chasing rounding noise. The
+// tolerance is floored at the rounding noise of the linesearch derivative.
+TEST_F(SolverTest, LineSearchStopsAtRoundingNoise) {
+  const std::string xml_path = GetTestDataFilePath(kHumanoidPath);
+  char error[1024];
+  MjModelPtr model(mj_loadXML(xml_path.c_str(), nullptr, error, sizeof(error)));
+  ASSERT_THAT(model.get(), NotNull()) << error;
+  model->opt.solver = mjSOL_NEWTON;
+  model->opt.tolerance = 0;
+
+  for (mjtCone cone : {mjCONE_PYRAMIDAL, mjCONE_ELLIPTIC}) {
+    model->opt.cone = cone;
+    MjDataPtr data = MakeData(model);
+    mj_resetDataKeyframe(model.get(), data.get(), 0);
+    int nsearch = 0, nexhausted = 0;
+    for (int step = 0; step < 50; step++) {
+      mj_step(model.get(), data.get());
+      int nisland = max(1, data->nisland);
+      for (int island = 0; island < std::min(nisland, mjNISLAND); island++) {
+        int niter = std::min(data->solver_niter[island], mjNSOLVER);
+        for (int i = 0; i < niter; i++) {
+          const mjSolverStat& stat = data->solver[island * mjNSOLVER + i];
+          nsearch++;
+          nexhausted += stat.neval >= model->opt.ls_iterations;
+        }
+      }
+    }
+    EXPECT_GT(nsearch, 0);
+    EXPECT_EQ(nexhausted, 0)
+        << "cone: " << (cone == mjCONE_ELLIPTIC ? "elliptic" : "pyramidal");
+  }
+}
