+// roots of a*x^2 + 2*b*x + c in (lo, hi) that satisfy s0 + s1*x >= 0: keep the nearest to target
+static void kinkRoots(mjtNum a, mjtNum b, mjtNum c, mjtNum s0, mjtNum s1,
+                      mjtNum lo, mjtNum hi, mjtNum target, mjtNum* best) {
+  mjtNum root[2];
+  int nroot = 0;
+
+  // linear
+  if (mju_abs(a) < mjMINVAL) {
+    if (mju_abs(b) >= mjMINVAL) {
+      root[nroot++] = -c / (2*b);
+    }
+  }
+
+  // quadratic: numerically stable form
+  else {
+    mjtNum disc = b*b - a*c;
+    if (disc >= 0) {
+      mjtNum q = -(b + (b < 0 ? -mju_sqrt(disc) : mju_sqrt(disc)));
+      root[nroot++] = q / a;
+      if (mju_abs(q) >= mjMINVAL) {
+        root[nroot++] = c / q;
+      }
+    }
+  }
+
+  for (int k=0; k < nroot; k++) {
+    mjtNum x = root[k];
+    if (lo < x && x < hi && s0 + s1*x >= 0 && mju_abs(x - target) < mju_abs(*best - target)) {
+      *best = x;
+    }
+  }
+}
+
+
+// the linesearch cost is piecewise smooth: its curvature jumps where a constraint changes zone
+// (inequality active/inactive, friction loss quadratic/linear, elliptic cone top/middle/bottom);
+// find the zone boundary in (lo, hi) nearest to target, return 0 if there is none
+static int PrimalKink(const mjPrimalContext* ctx, mjtNum lo, mjtNum hi, mjtNum target,
+                      mjtNum* kink) {
+  int ne = ctx->ne, nf = ctx->nf, nefc = ctx->nefc;
+  mjtNum best = mjMAXVAL;
+
+  for (int i=ne; i < nefc; i++) {
+    mjtNum start = ctx->Jaref[i], dir = ctx->Jv[i];
+
+    // friction loss: start + alpha*dir = -Rf or +Rf
+    if (i < ne + nf) {
+      mjtNum Rf = ctx->efc_R[i]*ctx->efc_frictionloss[i];
+      kinkRoots(0, 0.5*dir, start - Rf, 0, 0, lo, hi, target, &best);
+      kinkRoots(0, 0.5*dir, start + Rf, 0, 0, lo, hi, target, &best);
+    }
+
+    // elliptic cone, with N = U0 + alpha*V0 and T^2 = UU + 2*alpha*UV + alpha^2*VV:
+    //   top/middle: N = mu*T, N >= 0;  middle/bottom: mu*N = -T, N <= 0
+    else if (ctx->efc_type[i] == mjCNSTR_CONTACT_ELLIPTIC) {
+      const mjtNum* quad = ctx->quad + 3*i;
+      const mjContact* con = ctx->contact + ctx->efc_id[i];
+      mjtNum U0 = quad[3], V0 = quad[4], UU = quad[5], UV = quad[6], VV = quad[7];
+      mjtNum mu2 = con->mu*con->mu;
+      kinkRoots(V0*V0 - mu2*VV, U0*V0 - mu2*UV, U0*U0 - mu2*UU, U0, V0, lo, hi, target, &best);
+      kinkRoots(mu2*V0*V0 - VV, mu2*U0*V0 - UV, mu2*U0*U0 - UU, -U0, -V0, lo, hi, target, &best);
+      i += con->dim - 1;
+    }
+
+    // limit, pyramidal or frictionless contact: start + alpha*dir = 0
+    else {
+      kinkRoots(0, 0.5*dir, start, 0, 0, lo, hi, target, &best);
+    }
+  }
+
+  if (best == mjMAXVAL) {
+    return 0;
+  }
+  *kink = best;
+  return 1;
+}
