 }
 
 
+// warn if a CG or Newton linesearch used all ls_iterations; checked from the solver statistics
+// after the solve, since islands may be solved in parallel
+static void checkLinesearch(const mjModel* m, mjData* d, int nisland) {
+  for (int island=0; island < mjMIN(nisland, mjNISLAND); island++) {
+    int niter = mjMIN(d->solver_niter[island], mjNSOLVER);
+    for (int i=0; i < niter; i++) {
+      if (d->solver[island*mjNSOLVER + i].neval >= m->opt.ls_iterations) {
+        mj_warning(d, mjWARN_LINESEARCH, m->opt.ls_iterations);
+        return;
+      }
+    }
+  }
+}
+
+
 // compute efc_b, efc_force, qfrc_constraint; update qacc
 static void fwdConstraint(const mjModel* m, mjData* d, mjtSolver solver, int flg_island) {
   TM_START;
@@ -1301,6 +1316,11 @@ static void fwdConstraint(const mjModel* m, mjData* d, mjtSolver solver, int flg
     }
   }
 
+  // primal solvers: warn if a linesearch used all its evaluations
+  if (solver != mjSOL_PGS) {
+    checkLinesearch(m, d, islands_supported ? nisland : 1);
+  }
+
   // dual solvers: map efc_force to joint space (always monolithic)
   if (solver == mjSOL_PGS || m->opt.noslip_iterations > 0) {
     mj_dualFinish(m, d);
