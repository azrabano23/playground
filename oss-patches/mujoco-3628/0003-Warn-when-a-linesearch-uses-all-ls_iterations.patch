+// State from GitHub issue #3628: a free box on a plane with elliptic cones and
+// impratio=10, whose second Newton linesearch crosses the cone boundary.
+constexpr char kIssue3628Xml[] = R"(
+<mujoco>
+  <option timestep="0.0025" cone="elliptic" impratio="10"
+          integrator="implicitfast" iterations="100" tolerance="1e-8"/>
