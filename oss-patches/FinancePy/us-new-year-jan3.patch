From e88c6b164fb0061be5f2005ea39ad283ee5d70ab Mon Sep 17 00:00:00 2001
From: Azra Bano <azrabano.work@gmail.com>
Date: Mon, 28 Sep 2026 22:49:54 +0000
Subject: [PATCH] Stop treating Monday 3 January as a US New Year holiday

The UNITED_STATES calendar marked Monday 3 January as a holiday
whenever New Year's Day fell on a Saturday (2000, 2005, 2011, 2022,
2028, ...). Under US rules a Saturday holiday is observed on the
preceding Friday, which the calendar already handles via 31 December,
so these years ended up with an extra holiday on 3 January. That rule
belongs to the UK/Commonwealth calendars and looks to have been copied
from there.

Remove the 3 January rule and add a regression test.
---
 financepy/utils/calendar.py    |  3 ---
 tests/unit/test_FinCalendar.py | 10 ++++++++++
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/financepy/utils/calendar.py b/financepy/utils/calendar.py
index 3cb6cd3..58c0338 100644
--- a/financepy/utils/calendar.py
+++ b/financepy/utils/calendar.py
@@ -2038,9 +2038,6 @@ class Calendar:
         if m == 1 and d == 2 and weekday == Date.MON:  # NYD
             return True
 
-        if m == 1 and d == 3 and weekday == Date.MON:  # NYD
-            return True
-
         if m == 1 and d >= 15 and d < 22 and weekday == Date.MON:  # MLK
             return True
 
diff --git a/tests/unit/test_FinCalendar.py b/tests/unit/test_FinCalendar.py
index d7e077f..57dda70 100644
--- a/tests/unit/test_FinCalendar.py
+++ b/tests/unit/test_FinCalendar.py
@@ -182,6 +182,16 @@ def test_us_observed_independence_day_2010():
     assert cal.adjust(Date(4, 7, 2010), BusDayAdjustTypes.FOLLOWING) == Date(6, 7, 2010)
 
 
+def test_us_new_year_on_saturday_not_moved_to_monday():
+    # A Saturday New Year's Day is observed on Friday 31 December, never on
+    # Monday 3 January
+    cal = Calendar(CalendarTypes.UNITED_STATES)
+
+    assert cal.is_holiday(Date(31, 12, 2021))
+    assert cal.is_business_day(Date(3, 1, 2022))
+    assert cal.is_business_day(Date(3, 1, 2011))
+
+
 def test_modified_following_does_not_cross_month():
     cal = Calendar(CalendarTypes.WEEKEND)
 
