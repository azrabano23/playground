From feb01aeb26ef622a58ba77fcdeb813086b780086 Mon Sep 17 00:00:00 2001
From: Azra Bano <azrabano.work@gmail.com>
Date: Mon, 28 Sep 2026 22:46:23 +0000
Subject: [PATCH] Fix UK calendar treating moved bank holidays as holidays

When a UK bank holiday was moved (spring bank holiday in 2002, 2012
and 2022, early May bank holiday in 2020), the calendar added the new
date but still flagged the original Monday as a holiday. It also missed
the 2002 and 2012 jubilee dates and the 29 April 2011 royal wedding.

Skip the moved-from dates and add the missing one-off holidays. The
UNITED_KINGDOM and LONDON calendars now agree with QuantLib's UK
settlement calendar on every weekday from 2000 to 2030.
---
 financepy/utils/calendar.py    | 16 ++++++++++++++++
 tests/unit/test_FinCalendar.py | 21 +++++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/financepy/utils/calendar.py b/financepy/utils/calendar.py
index 3cb6cd3..3ba5d66 100644
--- a/financepy/utils/calendar.py
+++ b/financepy/utils/calendar.py
@@ -1185,8 +1185,24 @@ class Calendar:
         d = dt.d
         y = dt.y
 
+        # Regular bank holidays that were moved to another date.
+        moved_holidays = {
+            (2002, 5, 27),  # Spring bank holiday moved to 4 June
+            (2012, 5, 28),  # Spring bank holiday moved to 4 June
+            (2020, 5, 4),   # Early May bank holiday moved to 8 May
+            (2022, 5, 30),  # Spring bank holiday moved to 2 June
+        }
+
+        if (y, m, d) in moved_holidays:
+            return False
+
         # One-off or moved bank holidays.
         special_holidays = {
+            (2002, 6, 3),   # Golden Jubilee
+            (2002, 6, 4),   # Spring bank holiday moved from 27 May
+            (2011, 4, 29),  # Royal wedding
+            (2012, 6, 4),   # Spring bank holiday moved from 28 May
+            (2012, 6, 5),   # Diamond Jubilee
             (2020, 5, 8),   # Early May bank holiday moved for VE Day
             (2022, 6, 2),   # Spring bank holiday moved from 30 May
             (2022, 6, 3),   # Platinum Jubilee
diff --git a/tests/unit/test_FinCalendar.py b/tests/unit/test_FinCalendar.py
index d7e077f..baa9bc1 100644
--- a/tests/unit/test_FinCalendar.py
+++ b/tests/unit/test_FinCalendar.py
@@ -182,6 +182,27 @@ def test_us_observed_independence_day_2010():
     assert cal.adjust(Date(4, 7, 2010), BusDayAdjustTypes.FOLLOWING) == Date(6, 7, 2010)
 
 
+def test_uk_moved_bank_holidays():
+    # When a bank holiday is moved, the original date is a normal business day
+    for cal_type in (CalendarTypes.UNITED_KINGDOM, CalendarTypes.LONDON):
+        cal = Calendar(cal_type)
+
+        for d, m, y in [(27, 5, 2002), (28, 5, 2012), (4, 5, 2020), (30, 5, 2022)]:
+            assert cal.is_business_day(Date(d, m, y))
+
+        for d, m, y in [
+            (3, 6, 2002),
+            (4, 6, 2002),
+            (29, 4, 2011),
+            (4, 6, 2012),
+            (5, 6, 2012),
+            (8, 5, 2020),
+            (2, 6, 2022),
+            (3, 6, 2022),
+        ]:
+            assert cal.is_holiday(Date(d, m, y))
+
+
 def test_modified_following_does_not_cross_month():
     cal = Calendar(CalendarTypes.WEEKEND)
 
